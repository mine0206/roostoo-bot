# Copy this file to .env and fill in the values Roostoo gives your team.
# NEVER commit the real .env — it contains your secret key.
ROOSTOO_API_KEY=your_api_key_here
ROOSTOO_SECRET_KEY=your_secret_key_here
# How often the bot polls prices, in minutes. 60 = hourly bars.
LOOP_MINUTES=60
# Full rebalance every N loops (entries + resizing). 24 = once a day;
# all other loops only exit coins that failed the trend filter.
REBALANCE_EVERY_LOOPS=24
